  "components": {
    "schemas": {
      "CreateRideDTO": {
        "required": [
          "dropOffLocation",
          "pickupLocation",
          "status"
        ],
        "type": "object",
        "properties": {
          "dropOffLocation": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "pickupLocation": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "fare": {
            "maximum": 5000,
            "minimum": 20,
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "riderId": {
            "type": "integer",
            "format": "int32"
          },
          "driverId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateVehicleDTO": {
        "required": [
          "color",
          "model",
          "plateNumber"
        ],
        "type": "object",
        "properties": {
          "model": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "plateNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "color": {
            "minLength": 1,
            "type": "string"
          },
          "driverId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDTO": {
        "required": [
          "email",
          "fullName",
          "password",
          "phone",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "fullName": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
